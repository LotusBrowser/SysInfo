<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>SysInfo</AssemblyName>

		<!-- Supported publish targets -->
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>

		<!-- Single-file, self-contained only when a RID is supplied -->
		<SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
		<PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
		<EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>

		<DebugType>none</DebugType>
		<InvariantGlobalization>true</InvariantGlobalization>
		<Authors>Allen Lambert Jr</Authors>
		<Company>Lotus</Company>
		<Title>$(AssemblyName)</Title>
	</PropertyGroup>

	<!-- Windows-only app icon -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<ApplicationIcon>icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<Content Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Management" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="icon.ico">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- Publish Windows single-file -->
	<Target Name="PublishWindows">
		<MSBuild Projects="$(MSBuildProjectFullPath)"
				 Targets="Publish"
				 Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;EnableCompressionInSingleFile=true;PublishDir=$(MSBuildProjectDirectory)/publish/win-x64/" />
	</Target>

	<!-- Publish Linux single-file -->
	<Target Name="PublishLinux">
		<MSBuild Projects="$(MSBuildProjectFullPath)"
				 Targets="Publish"
				 Properties="Configuration=$(Configuration);RuntimeIdentifier=linux-x64;SelfContained=true;PublishSingleFile=true;EnableCompressionInSingleFile=true;PublishDir=$(MSBuildProjectDirectory)/publish/linux-x64/" />
	</Target>

	<!-- Publish both -->
	<Target Name="PublishAll" DependsOnTargets="PublishWindows;PublishLinux" />

</Project>